                    "401": {
                        "description": "\u041d\u0435 \u0430\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Missing X-Telegram-Init-Data header"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
