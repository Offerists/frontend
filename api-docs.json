        "/api/v1/tasks": {
            "get": {
                "tags": [
                    "Tasks"
                ],
                "summary": "\u041f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0441\u043f\u0438\u0441\u043e\u043a \u0437\u0430\u0434\u0430\u0447",
                "description": "\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0437\u0430\u0434\u0430\u0447\u0438 \u0441 \u0442\u0435\u043a\u0443\u0449\u0435\u0439 \u0434\u043e\u0441\u043a\u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f. \u0424\u0438\u043b\u044c\u0442\u0440 `active` \u2014 \u0437\u0430\u0434\u0430\u0447\u0438 \u043d\u0435 \u0432 \u0441\u0442\u0430\u0442\u0443\u0441\u0435 DONE; `all` \u2014 \u0432\u0441\u0435 \u0437\u0430\u0434\u0430\u0447\u0438.",
                "operationId": "getTasks",
                "parameters": [
                    {
                        "name": "filter",
                        "in": "query",
                        "description": "\u0424\u0438\u043b\u044c\u0442\u0440: `active` (\u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e) \u0438\u043b\u0438 `all`",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "active",
                            "enum": [
                                "active",
                                "all"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "\u0421\u043f\u0438\u0441\u043e\u043a \u0437\u0430\u0434\u0430\u0447",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "tasks": [
                                            {
                                                "id": "abc123",
                                                "title": "\u0414\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c UI",
                                                "description": "\u041f\u0440\u0430\u0432\u043a\u0438 \u043f\u043e \u043c\u0430\u043a\u0435\u0442\u0443",
                                                "status": "IN_PROGRESS",
                                                "statusLabel": "\u0412 \u0440\u0430\u0431\u043e\u0442\u0435",
                                                "deadline": "2025-07-01T00:00:00",
                                                "assigneeIds": [
                                                    "user-uuid-1"
                                                ]
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0438\u043b\u0438 \u043d\u0435\u0432\u0430\u043b\u0438\u0434\u043d\u044b\u0439 X-Telegram-Init-Data",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Missing X-Telegram-Init-Data header"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/integrations/yougile": {
