        "/api/v1/integrations/yougile/boards": {
            "get": {
                "tags": [
                    "YouGile Integration"
                ],
                "summary": "\u0421\u043f\u0438\u0441\u043e\u043a \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0445 \u0434\u043e\u0441\u043e\u043a",
                "description": "\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0432\u0441\u0435 \u0434\u043e\u0441\u043a\u0438 \u0442\u0435\u043a\u0443\u0449\u0435\u0439 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f. \u041f\u043e\u043b\u0435 `isDefault` \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u0443\u044e \u0434\u043e\u0441\u043a\u0443.",
                "operationId": "getBoards",
                "responses": {
                    "200": {
                        "description": "\u0421\u043f\u0438\u0441\u043e\u043a \u0434\u043e\u0441\u043e\u043a",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "boards": [
                                            {
                                                "id": "board-1",
                                                "name": "Sprint 1",
                                                "isDefault": true
                                            },
                                            {
                                                "id": "board-2",
                                                "name": "\u0411\u044d\u043a\u043b\u043e\u0433",
                                                "isDefault": false
                                            }
