{
    "openapi": "3.1.0",
    "info": {
        "title": "AIProjectManager Mini App API",
        "description": "REST API для Telegram Mini App.\n\n**Аутентификация** — заголовок `X-Telegram-Init-Data` со строкой `initData` из `window.Telegram.WebApp.initData` (HMAC-SHA256, подписан ботом).\nВремя жизни initData — 24 часа.\n\nВ dev-режиме (`MINIAPP_DEV_MODE=true`) вместо initData можно передавать заголовок `X-Dev-Telegram-User-Id` с числовым Telegram ID пользователя.\n",
        "contact": {
            "name": "AIProjectManager Team"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8081",
            "description": "Generated server url"
        }
    ],
    "security": [
        {
            "TelegramAuth": []
        }
    ],
    "tags": [
        {
            "name": "YouGile Integration",
            "description": "Подключение и управление интеграцией с YouGile"
        },
        {
            "name": "User",
            "description": "Профиль пользователя"
        },
        {
            "name": "Settings",
            "description": "Настройки пользователя"
        },
        {
            "name": "Tasks",
            "description": "Задачи текущей доски пользователя"
        }
    ],
    "paths": {
        "/api/v1/integrations/yougile/boards/{boardId}/select": {
            "put": {
                "tags": [
                    "YouGile Integration"
                ],
                "summary": "Выбрать доску",
                "description": "Устанавливает указанную доску как текущую для пользователя. Задачи в `/api/v1/tasks` будут браться с этой доски.",
                "operationId": "selectBoard",
                "parameters": [
                    {
                        "name": "boardId",
                        "in": "path",
                        "description": "ID доски в YouGile",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Доска выбрана"
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Missing X-Telegram-Init-Data header"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Доска не найдена",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Board not found"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/integrations/yougile/connect": {
            "post": {
                "tags": [
                    "YouGile Integration"
                ],
                "summary": "Подключить YouGile аккаунт",
                "description": "Подключает YouGile аккаунт пользователя.\n\n**Шаг 1**: передать `email` + `password` без `companyId`.\nЕсли у пользователя несколько компаний, вернётся `requiresCompanySelection: true`\nи список компаний.\n\n**Шаг 2**: повторить запрос с тем же `email`/`password` и выбранным `companyId`.\nПри успехе `connected: true` и список доступных досок.\n",
                "operationId": "connect",
                "requestBody": {
                    "description": "Учётные данные YouGile",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ConnectRequest"
                            },
                            "examples": {
                                "Шаг 1 — без companyId": {
                                    "description": "Шаг 1 — без companyId",
                                    "value": {
                                        "email": "user@example.com",
                                        "password": "secret"
                                    }
                                },
                                "Шаг 2 — с companyId": {
                                    "description": "Шаг 2 — с companyId",
                                    "value": {
                                        "email": "user@example.com",
                                        "password": "secret",
                                        "companyId": "c1"
                                    }
                                }
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Результат подключения",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ConnectResponse"
                                },
                                "examples": {
                                    "Одна компания — успех": {
                                        "description": "Одна компания — успех",
                                        "value": {
                                            "connected": true,
                                            "requiresCompanySelection": false,
                                            "companies": [],
                                            "boards": [
                                                {
                                                    "id": "board-uuid",
                                                    "name": "Бэклог",
                                                    "isDefault": true
                                                }
                                            ]
                                        }
                                    },
                                    "Несколько компаний": {
                                        "description": "Несколько компаний",
                                        "value": {
                                            "connected": false,
                                            "requiresCompanySelection": true,
                                            "companies": [
                                                {
                                                    "id": "c1",
                                                    "name": "Компания А"
                                                },
                                                {
                                                    "id": "c2",
                                                    "name": "Компания Б"
                                                }
                                            ],
                                            "boards": []
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Неверные учётные данные",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Invalid credentials"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Missing X-Telegram-Init-Data header"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/tasks/{taskId}/status": {
            "patch": {
                "tags": [
                    "Tasks"
                ],
                "summary": "Обновить статус задачи",
                "description": "Меняет статус задачи по её ID. Допустимые значения: `TODO`, `IN_PROGRESS`, `REVIEW`, `DONE`.",
                "operationId": "updateStatus",
                "parameters": [
                    {
                        "name": "taskId",
                        "in": "path",
                        "description": "ID задачи в YouGile",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "description": "Новый статус",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateTaskStatusRequest"
                            },
                            "example": {
                                "status": "IN_PROGRESS"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Обновлённая задача",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/TaskDto"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Invalid or expired init data"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Задача не найдена",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Task not found"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/settings/notifications": {
            "get": {
                "tags": [
                    "Settings"
                ],
                "summary": "Получить настройки уведомлений",
                "description": "Возвращает текущие настройки Telegram-уведомлений пользователя.",
                "operationId": "getNotifications",
                "responses": {
                    "200": {
                        "description": "Настройки уведомлений",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/NotificationSettingsResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Missing X-Telegram-Init-Data header"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "patch": {
                "tags": [
                    "Settings"
                ],
                "summary": "Обновить настройки уведомлений",
                "description": "Изменяет настройки уведомлений. Передавайте только те поля, которые нужно изменить.",
                "operationId": "updateNotifications",
                "requestBody": {
                    "description": "Поля для обновления (null-поля игнорируются)",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/NotificationSettingsRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Обновлённые настройки",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/NotificationSettingsResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Missing X-Telegram-Init-Data header"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/user/profile": {
            "get": {
                "tags": [
                    "User"
                ],
                "summary": "Профиль текущего пользователя",
                "description": "Возвращает профиль аутентифицированного пользователя: Telegram-данные, статус интеграции с YouGile и статистику задач.",
                "operationId": "getProfile",
                "responses": {
                    "200": {
                        "description": "Профиль пользователя",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProfileResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Missing X-Telegram-Init-Data header"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/tasks": {
            "get": {
                "tags": [
                    "Tasks"
                ],
                "summary": "Получить список задач",
                "description": "Возвращает задачи с текущей доски пользователя. Фильтр `active` — задачи не в статусе DONE; `all` — все задачи.",
                "operationId": "getTasks",
                "parameters": [
                    {
                        "name": "filter",
                        "in": "query",
                        "description": "Фильтр: `active` (по умолчанию) или `all`",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "active",
                            "enum": [
                                "active",
                                "all"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список задач",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "tasks": [
                                            {
                                                "id": "abc123",
                                                "title": "Доработать UI",
                                                "description": "Правки по макету",
                                                "status": "IN_PROGRESS",
                                                "statusLabel": "В работе",
                                                "deadline": "2025-07-01T00:00:00",
                                                "assigneeIds": [
                                                    "user-uuid-1"
                                                ]
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Отсутствует или невалидный X-Telegram-Init-Data",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Missing X-Telegram-Init-Data header"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/integrations/yougile": {
            "get": {
                "tags": [
                    "YouGile Integration"
                ],
                "summary": "Статус интеграции с YouGile",
                "description": "Возвращает текущее состояние подключения пользователя к YouGile.",
                "operationId": "getStatus",
                "responses": {
                    "200": {
                        "description": "Статус интеграции",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/YouGileStatusResponse"
                                },
                                "example": {
                                    "connected": true,
                                    "companyId": "company-uuid",
                                    "yougileUserId": "user-uuid",
                                    "role": "admin"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Missing X-Telegram-Init-Data header"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/integrations/yougile/boards": {
            "get": {
                "tags": [
                    "YouGile Integration"
                ],
                "summary": "Список доступных досок",
                "description": "Возвращает все доски текущей компании пользователя. Поле `isDefault` указывает выбранную доску.",
                "operationId": "getBoards",
                "responses": {
                    "200": {
                        "description": "Список досок",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "boards": [
                                            {
                                                "id": "board-1",
                                                "name": "Sprint 1",
                                                "isDefault": true
                                            },
                                            {
                                                "id": "board-2",
                                                "name": "Бэклог",
                                                "isDefault": false
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "example": {
                                        "error": "Missing X-Telegram-Init-Data header"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "BoardDto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "isDefault": {
                        "type": "boolean"
                    }
                }
            },
            "CompanyDto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                }
            },
            "ConnectResponse": {
                "type": "object",
                "properties": {
                    "connected": {
                        "type": "boolean"
                    },
                    "requiresCompanySelection": {
                        "type": "boolean"
                    },
                    "companies": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CompanyDto"
                        }
                    },
                    "boards": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/BoardDto"
                        }
                    }
                }
            },
            "ConnectRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    },
                    "companyId": {
                        "type": "string"
                    }
                }
            },
            "TaskDto": {
                "type": "object",
                "description": "Задача",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "ID задачи в YouGile",
                        "example": "abc123def456"
                    },
                    "title": {
                        "type": "string",
                        "description": "Название задачи",
                        "example": "Доработать UI кнопок"
                    },
                    "description": {
                        "type": "string",
                        "description": "Описание задачи",
                        "example": "Правки по макету v2"
                    },
                    "status": {
                        "type": "string",
                        "description": "Статус",
                        "enum": [
                            "TODO",
                            "IN_PROGRESS",
                            "REVIEW",
                            "DONE"
                        ],
                        "example": "IN_PROGRESS"
                    },
                    "statusLabel": {
                        "type": "string",
                        "description": "Читаемый статус на русском",
                        "example": "В работе"
                    },
                    "deadline": {
                        "type": "string",
                        "description": "Дедлайн в ISO 8601",
                        "example": "2025-07-01T00:00:00"
                    },
                    "assigneeIds": {
                        "type": "array",
                        "description": "Список YouGile ID исполнителей",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "UpdateTaskStatusRequest": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    }
                }
            },
            "NotificationSettingsResponse": {
                "type": "object",
                "properties": {
                    "digestEnabled": {
                        "type": "boolean"
                    },
                    "remindersEnabled": {
                        "type": "boolean"
                    }
                }
            },
            "NotificationSettingsRequest": {
                "type": "object",
                "properties": {
                    "digestEnabled": {
                        "type": "boolean"
                    },
                    "remindersEnabled": {
                        "type": "boolean"
                    }
                }
            },
            "ProfileResponse": {
                "type": "object",
                "properties": {
                    "telegramId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "username": {
                        "type": "string"
                    },
                    "fullName": {
                        "type": "string"
                    },
                    "yougileConnected": {
                        "type": "boolean"
                    },
                    "yougileRole": {
                        "type": "string"
                    },
                    "stats": {
                        "$ref": "#/components/schemas/StatsDto"
                    }
                }
            },
            "StatsDto": {
                "type": "object",
                "properties": {
                    "activeTasks": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "doneTasks": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "YouGileStatusResponse": {
                "type": "object",
                "properties": {
                    "connected": {
                        "type": "boolean"
                    },
                    "companyId": {
                        "type": "string"
                    },
                    "yougileUserId": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string"
                    }
                }
            }
        },
        "securitySchemes": {
            "TelegramAuth": {
                "type": "apiKey",
                "description": "Telegram WebApp initData — строка URL-encoded параметров с полем hash. Получается из window.Telegram.WebApp.initData.",
                "name": "X-Telegram-Init-Data",
                "in": "header"
            }
        }
    }
}
